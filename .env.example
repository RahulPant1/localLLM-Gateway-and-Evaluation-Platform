# Copy to .env (same folder) and adjust. .env is gitignored; never commit it.
# Every setting is optional: the defaults below are what the app uses if unset.

# Ollama service inside WSL.
GATEWAY_OLLAMA_URL=http://127.0.0.1:11434

# Context window (tokens) requested for models whose Modelfile sets none.
# Larger values use more VRAM.
GATEWAY_DEFAULT_NUM_CTX=8192

# Time limit in seconds for one generation, including loading the model.
GATEWAY_GENERATION_TIMEOUT_SECONDS=300

# Routing: "auto" asks the classifier model when the quick rules are unsure;
# "off" uses the quick rules only (no extra model load).
GATEWAY_ROUTER_LLM=auto

# Model registry and routing policy file.
GATEWAY_REGISTRY_PATH=config/models.yaml

# SQLite file. A relative path is resolved from the project root.
GATEWAY_DATABASE_PATH=data/gateway.db

# Claude model used as the judge (Phase 4).
GATEWAY_JUDGE_MODEL=claude-opus-5-5

# Claude API key for evaluation (Phase 4). Leave empty to run without evaluation.
# This is a Claude Console key with its own billing, not the Claude Code subscription.
GATEWAY_ANTHROPIC_API_KEY=

# Overview screen: cloud model used for the "what this would cost" estimate,
# in US dollars per million tokens. Set both prices to 0 to hide the estimate.
GATEWAY_CLOUD_COMPARE_MODEL=claude-opus-5-5
GATEWAY_CLOUD_INPUT_PER_MTOK=4
GATEWAY_CLOUD_OUTPUT_PER_MTOK=20

# OpenAI-compatible endpoint (/v1): whether requests from other tools think by
# default. false keeps them fast; a request can still ask with reasoning_effort.
GATEWAY_API_THINK=false
