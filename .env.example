# Copy to .env (same folder) and adjust. .env is gitignored; never commit it.
# Every setting is optional: the defaults below are what the app uses if unset.

# Ollama service inside WSL.
GATEWAY_OLLAMA_URL=http://127.0.0.1:11434

# SQLite file. A relative path is resolved from the project root.
GATEWAY_DATABASE_PATH=data/gateway.db

# Claude model used as the judge (Phase 4).
GATEWAY_JUDGE_MODEL=claude-opus-5-5

# Claude API key for evaluation (Phase 4). Leave empty to run without evaluation.
# This is a Claude Console key with its own billing, not the Claude Code subscription.
GATEWAY_ANTHROPIC_API_KEY=
